local function updateSlider(inputLocation)
    local trackAbsPos = sliderTrack.AbsolutePosition.X
    local trackAbsSize = sliderTrack.AbsoluteSize.X
    local scale = math.clamp((inputLocation.X - trackAbsPos) / trackAbsSize, 0, 1)

    flySpeed = math.floor(minSpeed + scale * (maxSpeed - minSpeed))
    sliderValLabel.Text = tostring(flySpeed)

    TweenService:Create(sliderKnob, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(scale, -8, 0.5, -8)
    }):Play()

    TweenService:Create(sliderFill, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(scale, 0, 1, 0)
    }):Play()
end

local function startDrag(input)
    isDraggingSlider = true
    updateSlider(input.Position)
end

sliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then startDrag(input) end
end)
