-- Helper Functions
local function getTargetPlayer(text)
    if not text or text:gsub("%s+", "") == "" then return nil end
    local query = text:lower()
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if p.Name:lower():sub(1, #query) == query or p.DisplayName:lower():sub(1, #query) == query then
                return p
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if p.Name:lower():find(query, 1, true) or p.DisplayName:lower():find(query, 1, true) then
                return p
            end
        end
    end
    return nil
end

local function getClosestPlayerToCursor()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local cam = workspace.CurrentCamera
    local mouse = player:GetMouse()
    local mousePos = Vector2.new(mouse.X, mouse.Y)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local char = p.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local screenPos, onScreen = cam:WorldToViewportPoint(char.HumanoidRootPart.Position)
                    if onScreen then
                        local dist = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestPlayer = p
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function getValidPlayers()
    local validList = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            table.insert(validList, p)
        end
    end
    return validList
end

local function updateSpectateView()
    local targets = getValidPlayers()
    if #targets == 0 then
        SpecUserLabel.Text = "No players found"
        workspace.CurrentCamera.CameraSubject = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        return
    end

    if specIndex > #targets then specIndex = 1 end
    if specIndex < 1 then specIndex = #targets end

    local targetPlayer = targets[specIndex]
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") then
        workspace.CurrentCamera.CameraSubject = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        SpecUserLabel.Text = targetPlayer.DisplayName .. " (@" .. targetPlayer.Name .. ")"
    else
        SpecUserLabel.Text = targetPlayer.Name .. " (No Character)"
    end
end

local function setSpectateActive(state, targetPlayerOverride)
    spectating = state
    if setSpectateToggleState then setSpectateToggleState(state) end

    if spectating then
        local targets = getValidPlayers()
        if targetPlayerOverride then
            for idx, p in ipairs(targets) do
                if p == targetPlayerOverride then
                    specIndex = idx
                    break
                end
            end
        end

        SpectateFrame.Visible = true
        TweenService:Create(SpectateFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, -160, 1, -70)
        }):Play()

        updateSpectateView()
    else
        local tweenOut = TweenService:Create(SpectateFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, -160, 1, 60)
        })
        tweenOut:Play()
        tweenOut.Completed:Connect(function()
            if not spectating then SpectateFrame.Visible = false end
        end)

        if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
            workspace.CurrentCamera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
        end
    end
end

PrevBtn.MouseButton1Click:Connect(function()
    specIndex = specIndex - 1
    updateSpectateView()
end)

NextBtn.MouseButton1Click:Connect(function()
    specIndex = specIndex + 1
    updateSpectateView()
end)

