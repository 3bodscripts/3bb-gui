-- --- ESP SYSTEM CORE ---
local espStorage = {}

local function createEspElements(p)
    if espStorage[p] then return end

    local elements = {
        Highlight = Instance.new("Highlight"),
        Billboard = Instance.new("BillboardGui"),
        NameLabel = Instance.new("TextLabel"),
        HealthBarBG = Instance.new("Frame"),
        HealthBarFill = Instance.new("Frame"),
        TracerLine = (Drawing and Drawing.new and Drawing.new("Line")) or nil,
        BoxOutline = (Drawing and Drawing.new and Drawing.new("Square")) or nil
    }

    elements.Highlight.Name = "ESPHighlight"
    elements.Highlight.FillColor = Color3.fromRGB(255, 50, 50)
    elements.Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    elements.Highlight.FillTransparency = 0.5
    elements.Highlight.Enabled = false

    elements.Billboard.Name = "ESPBillboard"
    elements.Billboard.Size = UDim2.new(0, 150, 0, 40)
    elements.Billboard.AlwaysOnTop = true
    elements.Billboard.Adornee = nil
    elements.Billboard.Enabled = false
    elements.Billboard.Parent = ScreenGui

    elements.NameLabel.Size = UDim2.new(1, 0, 0, 18)
    elements.NameLabel.BackgroundTransparency = 1
    elements.NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    elements.NameLabel.Font = Enum.Font.GothamBold
    elements.NameLabel.TextSize = 12
    elements.NameLabel.TextStrokeTransparency = 0.2
    elements.NameLabel.Parent = elements.Billboard

    elements.HealthBarBG.Size = UDim2.new(0, 80, 0, 6)
    elements.HealthBarBG.Position = UDim2.new(0.5, -40, 0, 20)
    elements.HealthBarBG.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    elements.HealthBarBG.BorderSizePixel = 0
    elements.HealthBarBG.Parent = elements.Billboard

    elements.HealthBarFill.Size = UDim2.new(1, 0, 1, 0)
    elements.HealthBarFill.BackgroundColor3 = Color3.fromRGB(50, 220, 50)
    elements.HealthBarFill.BorderSizePixel = 0
    elements.HealthBarFill.Parent = elements.HealthBarBG

    if elements.TracerLine then
        elements.TracerLine.Thickness = 1.5
        elements.TracerLine.Color = Color3.fromRGB(255, 50, 50)
        elements.TracerLine.Visible = false
    end

    if elements.BoxOutline then
        elements.BoxOutline.Thickness = 1.5
        elements.BoxOutline.Color = Color3.fromRGB(255, 50, 50)
        elements.BoxOutline.Filled = false
        elements.BoxOutline.Visible = false
    end

    espStorage[p] = elements
end

local function removeEspElements(p)
    if espStorage[p] then
        local e = espStorage[p]
        if e.Highlight then e.Highlight:Destroy() end
        if e.Billboard then e.Billboard:Destroy() end
        if e.TracerLine then e.TracerLine:Remove() end
        if e.BoxOutline then e.BoxOutline:Remove() end
        espStorage[p] = nil
    end
end

Players.PlayerRemoving:Connect(removeEspElements)

RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            createEspElements(p)
            local e = espStorage[p]
            local char = p.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            local isAlive = char and hrp and hum and hum.Health > 0

            e.Highlight.Enabled = false
            e.Billboard.Enabled = false
            if e.TracerLine then e.TracerLine.Visible = false end
            if e.BoxOutline then e.BoxOutline.Visible = false end

            if espEnabled and isAlive then
                if selectedEspType == "Highlights" then
                    e.Highlight.Parent = char
                    e.Highlight.Enabled = true

                elseif selectedEspType == "Name" then
                    e.Billboard.Adornee = char:FindFirstChild("Head") or hrp
                    e.NameLabel.Text = p.DisplayName
                    e.NameLabel.Visible = true
                    e.HealthBarBG.Visible = false
                    e.Billboard.Enabled = true

                elseif selectedEspType == "Health" then
                    e.Billboard.Adornee = char:FindFirstChild("Head") or hrp
                    e.NameLabel.Text = p.DisplayName
                    e.NameLabel.Visible = true
                    e.HealthBarBG.Visible = true
                    
                    local hpScale = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    e.HealthBarFill.Size = UDim2.new(hpScale, 0, 1, 0)
                    e.HealthBarFill.BackgroundColor3 = Color3.fromHSV(hpScale * 0.3, 0.9, 0.9)
                    e.Billboard.Enabled = true

                elseif selectedEspType == "Tracer" and e.TracerLine then
                    local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        e.TracerLine.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                        e.TracerLine.To = Vector2.new(screenPos.X, screenPos.Y)
                        e.TracerLine.Visible = true
                    end

                elseif selectedEspType == "Box (2D)" and e.BoxOutline then
                    local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local head = char:FindFirstChild("Head")
                        local headPos = head and cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or screenPos
                        local legPos = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

                        local height = math.abs(headPos.Y - legPos.Y)
                        local width = height * 0.65

                        e.BoxOutline.Size = Vector2.new(width, height)
                        e.BoxOutline.Position = Vector2.new(screenPos.X - width / 2, headPos.Y)
                        e.BoxOutline.Visible = true
                    end
                end
            end
        end
    end
end)

-- Fly System
local bodyVelocity, bodyGyro
RunService.RenderStepped:Connect(function()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart
    local hum = character:FindFirstChildOfClass("Humanoid")

    if flyEnabled and hum then
        hum.PlatformStand = true

        if not bodyVelocity or bodyVelocity.Parent ~= hrp then
            bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bodyVelocity.Parent = hrp

            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bodyGyro.P = 3000
            bodyGyro.Parent = hrp
        end

        local camera = workspace.CurrentCamera
        bodyGyro.CFrame = camera.CFrame

        local rawMove = hum.MoveDirection
        if rawMove.Magnitude > 0 then
            local localMove = camera.CFrame:VectorToObjectSpace(rawMove)
            local flyDir = (camera.CFrame.RightVector * localMove.X) + (camera.CFrame.LookVector * -localMove.Z)
            
            if flyDir.Magnitude > 0 then
                bodyVelocity.Velocity = flyDir.Unit * flySpeed
            else
                bodyVelocity.Velocity = Vector3.zero
            end
        else
            bodyVelocity.Velocity = Vector3.zero
        end
    else
        if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
        if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
        if hum and not flyEnabled then
            hum.PlatformStand = false
        end
    end
end)

-- Ground Detection Reset for Double Jump
RunService.Stepped:Connect(function()
    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.FloorMaterial ~= Enum.Material.Air then
        currentJumps = 0
    end
end)

-- Jump Request Logic
UserInputService.JumpRequest:Connect(function()
    if not infJumpEnabled then return end
    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    if limitJumpsEnabled then
        if currentJumps < 2 then
            currentJumps = currentJumps + 1
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    else
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)
